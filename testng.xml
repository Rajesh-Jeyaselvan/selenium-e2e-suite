<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SauceDemo POM Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="org.example.listeners.TestListener"/>
    </listeners>

    <test name="E2E Regression Tests">
        <classes>
            <class name="org.example.tests.LoginTest"/>
            <class name="org.example.tests.InventoryTest"/>
            <class name="org.example.tests.CartTest"/>
            <class name="org.example.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
